@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5 mb-5">
    <h1 class="display-4 text-primary mb-4">@ViewData["Title"]</h1>

    <p class="text-muted">Effective: <strong>May 13, 2025</strong></p>

    <p class="lead">We value your privacy. Here's how we handle your data in our Book Shop App.</p>

    <hr />

    <h5 class="text-secondary mt-4">🔍 Data We Collect</h5>
    <ul class="list-group list-group-flush mb-3">
        <li class="list-group-item">Your name and email</li>
        <li class="list-group-item">Order details (book titles, quantities, dates)</li>
        <li class="list-group-item">Payment and transaction information</li>
        <li class="list-group-item">Device details (IP address, browser type)</li>
    </ul>

    <h5 class="text-secondary mt-4">🛠️ Usage</h5>
    <p>We use your data to process orders, improve user experience, secure your account, and provide customer support.</p>

    <h5 class="text-secondary mt-4">🔐 Security & Sharing</h5>
    <p>We do not sell your data. It may be shared with trusted services only when necessary for order processing, security, or legal compliance.</p>

    <h5 class="text-secondary mt-4">📬 Your Rights</h5>
    <p>You have the right to access, modify, or delete your data. Contact us at <a href="mailto:rakib1234@gmail.com">rakib123@gmail.com</a>.</p>

    <h5 class="text-secondary mt-4">📢 Updates</h5>
    <p>This privacy policy may be updated periodically. Please check back occasionally for any changes.</p>
</div>

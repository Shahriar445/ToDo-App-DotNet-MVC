@model Book
@{
    ViewBag.Title = "Book Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">📖 Book Details</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <h2 class="text-primary">@Model.Title</h2>
                            <h5 class="text-muted mb-3">by @Model.Author</h5>

                            <div class="mb-3">
                                <span class="badge bg-secondary me-2">@Model.Genre</span>
                                @if (Model.InStock)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">ISBN:</dt>
                                <dd class="col-sm-7">@Model.ISBN</dd>

                                <dt class="col-sm-5">Price:</dt>
                                <dd class="col-sm-7">
                                    <span class="h4 text-success">@Model.Price.ToString("C")</span>
                                </dd>

                                <dt class="col-sm-5">Publication Date:</dt>
                                <dd class="col-sm-7">@Model.PublicationDate.ToString("MMMM dd, yyyy")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">Stock Quantity:</dt>
                                <dd class="col-sm-7">
                                    <span class="badge bg-info">@Model.StockQuantity units</span>
                                </dd>

                                <dt class="col-sm-5">Availability:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.InStock && Model.StockQuantity > 0)
                                    {
                                        <span class="text-success">✅ Available</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">❌ Not Available</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr />
                        <div class="mt-4">
                            <h5 class="text-secondary">Description:</h5>
                            <p class="lead">@Model.Description</p>
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                ✏️ Edit Book
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                🗑️ Delete Book
                            </a>
                        </div>
                        <a asp-action="Index" class="btn btn-primary">
                            📚 Back to Books
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<Book>
@{
    ViewBag.Title = "Book Shop";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">📚 Book Shop</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Book
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">@book.Title</h5>
                            <small>by @book.Author</small>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="mb-3">
                                <span class="badge bg-secondary">@book.Genre</span>
                                @if (book.InStock)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </div>

                            <p class="text-muted small">
                                <strong>ISBN:</strong> @book.ISBN<br />
                                <strong>Published:</strong> @book.PublicationDate.ToString("MMM yyyy")<br />
                                <strong>Stock:</strong> @book.StockQuantity units
                            </p>

                            @if (!string.IsNullOrEmpty(book.Description))
                            {
                                <p class="card-text">
                                    @(book.Description.Length > 100 ? book.Description.Substring(0, 100) + "..." : book.Description)
                                </p>
                            }

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="text-success mb-0">@book.Price.ToString("C")</h4>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-primary btn-sm" title="View Details">
                                            👁️
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-warning btn-sm" title="Edit">
                                            ✏️
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                            🗑️
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-book" style="font-size: 4rem; color: #ccc;"></i>
            </div>
            <h4 class="text-muted">No books available</h4>
            <p class="text-muted">Start by adding your first book to the shop.</p>
            <a asp-action="Create" class="btn btn-primary btn-lg">
                📚 Add First Book
            </a>
        </div>
    }
</div>